const { SocksProxyAgent } = require('socks-proxy-agent');
const axios = require('axios');

export default async function handler(req, res) {
    if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });

    const { proxyConfig } = req.body;
    
    const host = proxyConfig?.host || process.env.MASTER_PROXY_HOST;
    const port = proxyConfig?.port || process.env.MASTER_PROXY_PORT;
    const user = proxyConfig?.user || process.env.MASTER_PROXY_USER;
    const pass = proxyConfig?.pass || process.env.MASTER_PROXY_PASS;

    if (!host || !port) {
        return res.status(500).json({ success: false, error: "No Proxy Selected or Configured." });
    }

    const proxyUrl = `socks5h://${user}:${pass}@${host}:${port}`;
    
    try {
        const agent = new SocksProxyAgent(proxyUrl);
        const ipInfo = await axios.get('http://ip-api.com/json', { 
            httpAgent: agent, 
            httpsAgent: agent,
            timeout: 8000 
        });

        return res.status(200).json({
            success: true,
            query: ipInfo.data.query, // This confirms the AWS IP is active
            isp: ipInfo.data.isp
        });
    } catch (error) {
        return res.status(500).json({ success: false, error: "Tunnel Blocked: " + error.message });
    }
}
