const { SocksProxyAgent } = require('socks-proxy-agent');
const axios = require('axios');

export default async function handler(req, res) {
    if (req.method !== 'POST') return res.status(405).json({ error: 'Method Not Allowed' });
    try {
        const { proxyConfig } = req.body;
        const host = proxyConfig?.host || process.env.MASTER_PROXY_HOST;
        const port = proxyConfig?.port || process.env.MASTER_PROXY_PORT;
        const user = proxyConfig?.user || process.env.MASTER_PROXY_USER;
        const pass = proxyConfig?.pass || process.env.MASTER_PROXY_PASS;

        if (!host || !port) return res.status(200).json({ success: false, error: "Missing Proxy Config" });

        const agent = new SocksProxyAgent(`socks5h://${user}:${pass}@${host}:${port}`);
        const response = await axios.get('http://ip-api.com/json', { 
            httpAgent: agent, httpsAgent: agent, timeout: 15000 
        });

        return res.status(200).json({ success: true, query: response.data.query, isp: response.data.isp });
    } catch (error) {
        return res.status(200).json({ success: false, error: "Tunnel Timeout: Check AWS Security Groups" });
    }
}
