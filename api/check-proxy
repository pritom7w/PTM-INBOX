const axios = require('axios');
const { SocksProxyAgent } = require('socks-proxy-agent');
const fs = require('fs');
const path = require('path');

export default async function handler(req, res) {
    try {
        // Load the proxy from your json file
        const filePath = path.join(process.cwd(), 'proxies.json');
        const fileData = fs.readFileSync(filePath, 'utf8');
        const proxies = JSON.parse(fileData);
        const p = proxies[0]; // Take the first proxy

        const agent = new SocksProxyAgent(`socks5://${p.user}:${p.pass}@${p.host}:${p.port}`);
        
        // Test the connection via ip-api
        const response = await axios.get('http://ip-api.com/json', { 
            httpAgent: agent, 
            httpsAgent: agent,
            timeout: 5000 
        });

        return res.status(200).json({ 
            success: true, 
            ip: response.data.query,
            isp: response.data.isp,
            city: response.data.city 
        });
    } catch (error) {
        return res.status(500).json({ success: false, error: error.message });
    }
}
