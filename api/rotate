// Example logic for rotating the active IP
export default async function handler(req, res) {
  if (req.method === 'POST') {
    const { nextIpId } = req.body;
    
    // 1. Set all proxies to status: false
    await db.proxies.updateMany({}, { $set: { status: false } });
    
    // 2. Set the selected one to status: true
    await db.proxies.updateOne({ _id: nextIpId }, { $set: { status: true } });
    
    return res.status(200).json({ message: "IP Swapped Instantly" });
  }
}
