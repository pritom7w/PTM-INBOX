const nodemailer = require('nodemailer');
const { SocksProxyAgent } = require('socks-proxy-agent');

export default async function handler(req, res) {
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method Not Allowed' });
  
  const { smtpConfig, mailData, proxyConfig } = req.body; // Boss, we now catch the proxy from the UI

  let agent = null;
  // Priority 1: Use the proxy selected in the UI
  // Priority 2: Fallback to Environment Variables
  const host = proxyConfig?.host || process.env.MASTER_PROXY_HOST;
  const port = proxyConfig?.port || process.env.MASTER_PROXY_PORT;
  const user = proxyConfig?.user || process.env.MASTER_PROXY_USER;
  const pass = proxyConfig?.pass || process.env.MASTER_PROXY_PASS;

  if (host && port) {
    const proxyAuth = (user && pass) ? `${user}:${pass}@` : '';
    agent = new SocksProxyAgent(`socks5h://${proxyAuth}${host}:${port}`);
  }

  const transporter = nodemailer.createTransport({
    host: smtpConfig.host,
    port: parseInt(smtpConfig.port),
    secure: parseInt(smtpConfig.port) === 465,
    auth: { user: smtpConfig.user, pass: smtpConfig.pass },
    pool: true,
    maxConnections: 3,
    ...(agent && { agent }),
    tls: { rejectUnauthorized: false, minVersion: 'TLSv1.2' }
  });

  try {
    const info = await transporter.sendMail({
      from: `"${mailData.fromName}" <${smtpConfig.user}>`,
      to: mailData.to,
      subject: mailData.subject,
      html: mailData.html,
      attachments: mailData.attachments || [],
      list: { unsubscribe: { url: 'https://vpn-servic.site/unsubscribe' } },
      headers: { 'X-Entity-Ref-ID': Math.random().toString(36).substring(7), 'Precedence': 'bulk' }
    });
    return res.status(200).json({ success: true, messageId: info.messageId });
  } catch (error) {
    return res.status(500).json({ success: false, error: error.message });
  }
}
