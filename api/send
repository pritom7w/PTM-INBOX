const nodemailer = require('nodemailer');
const { SocksProxyAgent } = require('socks-proxy-agent');

export default async function handler(req, res) {
    if (req.method !== 'POST') return res.status(405).json({ error: 'Method Not Allowed' });
    
    const { smtpConfig, mailData, proxyConfig } = req.body;

    // Build Proxy Agent
    let agent = null;
    if (proxyConfig && proxyConfig.host) {
        const proxyUrl = `socks5://${proxyConfig.user}:${proxyConfig.pass}@${proxyConfig.host}:${proxyConfig.port}`;
        agent = new SocksProxyAgent(proxyUrl);
    }

    const transporter = nodemailer.createTransport({
        host: smtpConfig.host,
        port: parseInt(smtpConfig.port),
        secure: parseInt(smtpConfig.port) === 465,
        auth: { user: smtpConfig.user, pass: smtpConfig.pass },
        // IMPORTANT: Disable pooling for Serverless Functions to prevent timeouts
        pool: false, 
        ...(agent && { agent }),
        tls: { rejectUnauthorized: false }
    });

    try {
        const info = await transporter.sendMail({
            from: `"${mailData.fromName}" <${smtpConfig.user}>`,
            to: mailData.to,
            subject: mailData.subject,
            html: mailData.html,
            attachments: mailData.attachments || [],
            headers: { 
                'List-Unsubscribe': '<https://p7m.online/unsub>', 
                'Precedence': 'bulk',
                'X-Mailer': 'P7M-Ultra-Evolution'
            }
        });

        // Close connection immediately for Serverless efficiency
        transporter.close(); 
        
        return res.status(200).json({ success: true, messageId: info.messageId });
    } catch (error) {
        console.error("Mail Error:", error.message);
        return res.status(500).json({ success: false, error: error.message });
    }
}
